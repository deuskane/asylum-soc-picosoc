# Revisions  :
# Date        Version  Author   Description
# 2021-10-26  1.0.0    mrosiere Created
# 2021-11-03  1.0.1    mrosiere Use generator
# 2021-11-16  1.0.2    mrosiere Add identity.c
# 2022-01-06  1.0.3    mrosiere Support nxmap
# 2022-07-13  1.1.0    mrosiere DATA_OE_<INIT/FORCE> in NB_IO
# 2024-12-31  1.1.1    mrosiere Fix constant in gpio declaration
# 2025-01-04  1.1.2    mrosiere Update Target and Makefile 
# 2025-01-06  1.1.3    mrosiere Add reset resynchonizer
# 2025-01-06  1.1.4    mrosiere Add top level to separate clock and reset management
#                               Usefull to student
# 2025-01-12  2.0.0    mrosiere Add supervisor and add safety
# 2025-01-15  2.1.0    mrosiere Support TMR safety
# 2025-01-21  2.2.0    mrosiere Add UART
# 2025-01-21  2.2.1    mrosiere Add UART Baud Rate in tb
# 2025-03-08  2.2.2    mrosiere Use unconstrained pbi
# 2025-03-30  2.3.0    mrosiere Use ICN
# 2025-04-05  2.3.1    mrosiere Change AddressMap to be compliant with OneHot encoding
# 2025-04-08  2.3.2    mrosiere Add parameters for ICN
# 2025-04-14  2.3.3    mrosiere Add debug bus
# 2025-05-14  2.4.0    mrosiere Change default BAUD TICK
# 2025-06-16  2.5.0    mrosiere Add SPI
# 2025-07-04  2.6.0    mrosiere Add GIC (Supervisor)
# 2025-07-09  2.6.1    mrosiere Configure UART and SPI FIFO
# 2025-07-29  2.7.0    mrosiere Add GIC (User)
# 2025-08-02  2.7.1    mrosiere Add Uart CTS/RTS
# 2025-08-11  2.7.2    mrosiere Use Target Techmap
# 2025-08-31  2.7.3    mrosiere Cosmetics : rename generate and esw
# 2025-10-18  2.7.4    mrosiere Add software modbus
# 2025-11-02  2.8.0    mrosiere Add Timer (User)
# 2025-11-10  2.8.1    mrosiere Add debug bus from uart and set to 4 the FIFO depth
# 2025-11-22  2.8.2    mrosiere Use sbi instead pbi
# 2025-11-26  2.8.3    mrosiere Use uvvm instead uvvm light
# 2025-11-27  2.9.0    mrosiere Add CRC (User)
# 2025-12-06  2.9.1    mrosiere Add Generic LOCK_STEP_DEPTH (User)
# 2025-12-30  2.9.2    mrosiere rename tb_PicoSoC_modbus to tb_PicoSoC_modbus_rtu
#                               Add targets
# 2026-01-17  2.9.3    mrosiere Move it sync dff into GIC
# 2026-05-09  3.0.0    mrosiere Add Generic CPU_MODEL
# 2026-05-24  3.0.1    mrosiere Change Supervisor ICN Address Encoding
# 2026-05-27  3.1.0    mrosiere Add spinlock and mailbox
# 2026-06-05  3.2.0    mrosiere Use ICN with NB_MASTER
# 2026-06-06  3.2.1    mrosiere Rename LED
#                               Add name
# 2026-06-17  3.2.2    mrosiere Add RAM2 for shared memories
# 2026-08-01  3.2.3    mrosiere Use GPIO_irq instead of GPIO
# 2026-08-22  3.3.0    mrosiere Update SPI controller
# 2026-10-05  3.3.1    mrosiere Fix default toplevel (PicoSoC_top), remove duplicated target,
#                               fix USER_SPI_DEPTH_* names in emu targets,
#                               rename emu_ng_medium_soc1_*_c_user to emu_ng_medium_soc4_*_fault_spi,
#                               emu_basys WardRV target uses user_identity.c (rvcc_gen has no psm),
#                               PicoSoC_top CPU_MODEL default, OR of diff_o with NB_CPU > 1,
#                               add missing gen_*_user_c_uart_9600 generators
# 2026-11-15  3.3.2    mrosiere esw : clear the ISR before unmasking (asylum:system:GIC 2.0.0
#                               records the masked sources too)
# 2026-11-19  4.0.0    mrosiere it_user_i resynchronized in the user GIC, data bus compared
#                               in lock-step / TMR (asylum:utils:pkg >= 1.9.0), ICN2 address
#                               width, NG-MEDIUM SPI pads (USER_SPI_NB_IO = 2, inputs
#                               without pad tied to 0), USER_NB_LED0 / 1 other than 8,
#                               mailbox "data available" sources 3 / 4 on the user GIC
#                               (mailbox >= 1.1.0, GIC >= 2.0.0), esw uart.h for uart 3.0.0
#                               (UART_IT_TX_EMPTY), cpu_nop; tb_PicoSoC checks the user
#                               interruption, the UART output and the multi-CPU progress;
#                               targets: emu_basys_* removed, lint_ghdl_synth_basys renamed
#                               lint_ghdl_synth_4leds_reset_high, sim_soc4_*_fault_c_user_uart
#                               renamed sim_soc4_*_c_user_uart
# 2026-11-22  4.1.0    mrosiere UART pads shared by the user UART, the HWLA UART and JTAG
#                               (asylum:debug:jtag jtag_pad_mux, switch_i MSBs, FTDI MPSSE
#                               pinout : uart_tx_io, uart_cts_b_io, uart_rts_b_io), JTAG chain :
#                               WardRV_debug of the user / supervisor CPU
#                               (USER_CPU_DEBUG_ENABLE, SUPERVISOR_CPU_DEBUG_ENABLE), TAP of
#                               fault injection and status (DEBUG_ENABLE); tb : JTAG BFM
#                               (asylum:verification:uvvm 1.1.0), scenarios pad_mux, jtag_*
# 2026-11-23  4.2.0    mrosiere Switch code 11 = JTAG over the UART pads (asylum:debug:jtag
#                               jtag_bitbang, OpenOCD remote_bitbang, JTAG_BAUD_RATE, SRST
#                               resets the user SoC); TMR vote with vote of sbi_pkg
#                               (asylum:utils:pkg 1.11.0); PicoSoC_hwla, PicoSoC_tap; cpu_ics in
#                               the HWLA probes; tb : JTAG BFM chain fields
#                               (asylum:verification:uvvm 1.2.0), scenarios bitbang_*,
#                               jtag_last
# 2026-11-23  4.3.0    mrosiere esw/demo/user.c prints the loop line at every iteration (tb :
#                               echo on a quiet line with CTS*), mailbox test on hart 0 only ;
#                               cpu_safety : one record per CPU, a loop over the copies ;
#                               polarities with active_high ; PicoSoC_clkrst,
#                               PicoSoC_jtag_over_uart ; HWLA_BAUD_RATE ; debug_mux_sel_i
#                               (function of the UART pads, was the switch MSBs ; NG-MEDIUM :
#                               4 user switches) ; core : one YAML anchor per configuration
# 2026-11-23  4.4.0    mrosiere uart_core (asylum:communication:uart 3.1.0) in PicoSoC_hwla
#                               (transmitter only) and PicoSoC_jtag_over_uart (RX synchronizer
#                               inside uart_core) ; top : USER_CPU_DEBUG_ENABLE and
#                               SUPERVISOR_CPU_DEBUG_ENABLE in the USER / SUPERVISOR groups of
#                               generics
# 2026-11-24  4.5.0    mrosiere top : HWLA_DEPTH, HWLA_PRE_TRIGGER, HWLA_TIMESTAMP_WIDTH (HWLA of
#                               PicoSoC_hwla, were 64, 32, 16) ; doc : page jtag names uart_core
# 2026-11-24  4.6.0    mrosiere tb : JTAG over the UART on the remote_bitbang BFM rbb_bfm_pkg
#                               (asylum:verification:uvvm 1.3.0) ; OpenOCD + GDB co-simulation of
#                               debug_mux_sel_i 10 and 11 (asylum:verification:openocd 1.0.0,
#                               gdb_lib.py of WardRV 1.5.0), sim/openocd/picosoc.cfg
# 2026-11-24  4.6.1    mrosiere esw sorted into system / demo / protocol / test,
#                               user_xmodem.c removed (did not compile)
# 2026-11-25  4.7.0    mrosiere tb : OpenOCD co-simulation of the JTAG chain of 4 TAPs
#                               (sim_soc3x2_wardrv_fsm_c_user_openocd_chain, chain.cfg :
#                               IDCODEs, 3 riscv targets) ; picosoc.cfg : chain given by
#                               picosoc_chain
# 2026-11-25  4.7.1    mrosiere NG-MEDIUM : UART pads and debug_uart_tx_o on
#                               Bank0 (3.3V, TP2) ; Bank5 and Bank12 at 2.5V ;
#                               HWLA_BAUD_RATE and JTAG_BAUD_RATE at 9600 like
#                               USER_BAUD_RATE (UART pads shared)
# 2026-11-26  4.7.2    mrosiere tools/modbus and tools/openocd (OpenOCD files of the
#                               board) ; adapters ft232r.cfg, ft232h.cfg,
#                               remote_bitbang.cfg (adapter only) ; JTAG chain discovery
#                               discover.cfg (sim_soc3x2_wardrv_fsm_c_user_openocd_discover,
#                               sim_soc1_wardrv_fsm_c_user_openocd_discover) ;
#                               NG-MEDIUM : no pull-down on CTS* / TDO (the pads
#                               have no pull-down, default pull-up) ;
#                               modbus_server_debug.py : base address as integer ;
#                               ft232r.cfg : adapter speed 10 kHz (checked on the board) ;
#                               remote_bitbang.cfg, ft232r.cfg : transport select jtag ;
#                               tools/openocd/remote_bitbang_setup.sh (stty + socat,
#                               JTAG over the UART on the board) ;
#                               tools/openocd/openocd.sh (checks of the host, then
#                               OpenOCD with an adapter and a chain file) ;
#                               picosoc.cfg : picosoc_status (STATUS of the
#                               injection / status TAP), picosoc_poll (no target) ;
#                               emu_ng_medium_soc3_wardrv_fsm_fault_debug (HWLA,
#                               injection / status TAP, both CPU debuggers) ;
#                               picosoc.cfg generic : without picosoc_chain, the chain is
#                               discovered (discover.tcl, shared with discover.cfg)
#                               (sim_soc1_wardrv_fsm_c_user_openocd_generic,
#                               sim_soc3x2_wardrv_fsm_c_user_openocd_generic) ;
#                               NG-MEDIUM : switch comments of pads.py fixed
#                               (debug_mux_sel_i(1) = S5, (0) = S6, S5 S6 left to right) ;
#                               every TAP of the JTAG chain resynchronizes TCK on the SoC
#                               clock (PicoSoC_tap, PicoSoC_supervisor, as cpu_safety) ;
#                               tb : scenario jtag_glitch (bounces on TCK,
#                               sim_soc3_wardrv_fsm_fault_c_user_uart_jtag_jtag_glitch) ;
#                               error injection trapped (PicoSoC_inject) : a request, even of
#                               one cycle (button resynchronized, or TAP), stays until the
#                               difference flags of the copy (TMR : both pairs) or a 1 -> 0 of
#                               the TAP request, power-on reset ; tb : inject_error of one SoC
#                               cycle, scenarios trap_cpu0, trap_cpu1, trap_reset, trap_tap ;
#                               one TCK synchronizer for the whole JTAG chain in PicoSoC_top
#                               (after the pad multiplexer), the ones of cpu_safety,
#                               PicoSoC_supervisor and PicoSoC_tap removed ;
#                               trap of the error injection cleared on the rising edge of any
#                               difference flag of the copy, the same for lock-step and TMR
#                               (PicoSoC_inject without SAFETY) ; tb fault_tmr : requests of one
#                               SoC cycle, CPU2 again leaves its trap pending (error after the
#                               next reset, then CPU0 resets) ;
#                               tools/uart/uart.sh (screen in xterm, checks),
#                               tools/hwla/hwla_capture.sh (captures of the HWLA on the UART)
# 2026-11-27  4.8.0    mrosiere HWLA_LINK : HWLA captures on the UART or through the TAP of
#                               jtag_axis (asylum:debug:jtag >= 1.3.0, IDCODE 0x10004001, in
#                               the JTAG chain before the injection / status TAP) ; flags of
#                               the HWLA (arm, armed, triggered, sending) in STATUS of the
#                               injection / status TAP ; tb : hwla on both links, jtag_status
#                               with the HWLA flags, sim_soc2_<cpu>_fault_c_user_hwla_jtag,
#                               sim_soc3_wardrv_fsm_fault_c_user_uart_hwla_jtag_<test> ;
#                               tools/openocd : picosoc_hwla_status, picosoc_hwla_dump (on
#                               jtag_axis.tcl of asylum-debug-jtag), picosoc_status with the
#                               HWLA flags ; tools/hwla/*.args copied to hwla/ next to
#                               hwla2vcd.py (asylum:debug:HWLA >= 3.1.0, named signals) ;
#                               co-simulation
#                               sim_soc3_wardrv_fsm_fault_c_user_openocd_hwla ;
#                               emu_ng_medium_soc3_wardrv_fsm_fault_debug_hwla_jtag
# 2026-11-27  4.8.1    mrosiere tools/openocd/jtag_axis.tcl : copy of the procedures
#                               of asylum-debug-jtag, sourced by picosoc.cfg from its
#                               own directory ; sim/openocd/hwla_vcd.sh (was hwla_tools.sh) ;
#                               picosoc_hwla_dump : hexadecimal text without the Tcl
#                               command binary (xPack OpenOCD) or for *.hex ;
#                               tools/udev (rules of the FTDI cables, install.sh)
# 2026-11-27  4.8.2    mrosiere README : Resources measured again ; doc/picosoc.drawio :
#                               TAP of the HWLA in the JTAG chain (page jtag)
# 2026-11-27  4.8.3    mrosiere cpu_safety : SEU_BIT of WardRV on the rd field
#                               (bits 7 / 8 / 9, were 0 / 1 / 2) ;
#                               tools/openocd/picosoc_cmds.tcl (short commands of the
#                               telnet session : status, stop / run, read_mem ...) ;
#                               esw/demo/user_loop.c (LED0 = switches, one UART line
#                               per loop : Loop <n> <xorwow>) ; tb : scenario
#                               sequence (lines checked against xorwow) ;
#                               sim_soc1_wardrv_fsm_c_user_loop,
#                               emu_ng_medium_soc1_wardrv_fsm_user_loop
# 2026-11-27  4.8.4    mrosiere HWLA : trigger on the error injection (rising edge of
#                               the traps of PicoSoC_inject of the copies present :
#                               push buttons or TAP, every safety configuration), the
#                               difference flags in the probes (WardRV_fsm 74,
#                               OpenBlaze8 60) ; NG-MEDIUM targets : HWLA_DEPTH 1024,
#                               HWLA_PRE_TRIGGER 16 (tools/hwla/*.args, hwla_capture.sh,
#                               picosoc_hwla_dump : 12288 bytes) ; WardRV_fsm boards on
#                               user_loop.c (but the SPI flash and Modbus builds) ;
#                               tb : scenarios hwla (push button) and hwla_tap (TAP
#                               INJECT), field diff, one capture per injection,
#                               sim_soc{1,2,5}_<cpu>_fault_c_user_hwla* ;
#                               INJECT of the injection / status TAP on 16 bits :
#                               [6:4], [10:8], [14:12] injection inside the CPU copy
#                               0, 1, 2 (3 requests per copy, a pulse per 0 -> 1 on
#                               inject_cpu_i of cpu_safety, inject_i of cpu_wrapper,
#                               unused by the reference CPUs) ; picosoc_inject_cpu
#                               <copy> <mask> ;
#                               tb : scenario jtag_inject_cpu, tb_PicoSoC_tap (the TAP
#                               alone : sim_tap_inject, sim_tap_inject_cpu) ; README :
#                               Resources of DEBUG_ENABLE measured again ;
#                               tools/openocd/ft232r.cfg : adapter speed 1 MHz
# 2026-11-28  4.8.5    mrosiere INJECT : 4 bits of injection inside each CPU copy
#                               ([7:4], [11:8], [15:12] : the reserved bits 7, 11, 15
#                               become the bit 3 of each copy), inject_cpu_i of 12
#                               bits, inject_i of cpu_wrapper of 4 bits (e.g. bit 3 :
#                               the register file), also a trigger of the HWLA ;
#                               picosoc_inject_cpu : mask of 4 bits ; tb :
#                               sim_tap_inject_cpu (12 bits), jtag_inject_cpu (HWLA
#                               triggered by the bit 3) ; README : Resources
# 2026-11-27  4.8.5    mrosiere Student branch (ESIEE SEI-5201A labs) :
#                               cpu_safety : SAFETY = "none" only,
#                               lock-step and TMR are holes to write ;
#                               configurations in the order of the labs :
#                               soc1 = WardRV_fsm, supervisor, SAFETY none,
#                               fault injection (the reference), soc2 = soc1
#                               with lock-step, soc3 = soc1 with TMR (holes :
#                               _sim_ / _emu_ targets) ; integration tests
#                               sim_soc1_wardrv_fsm_fault_c_test_<ip>,
#                               OpenOCD co-simulations in soc1, HWLA
#                               scenarios and co-simulation on soc2 ;
#                               scenario fault_none (an error in the only
#                               CPU : the firmware derails, the supervisor
#                               sees nothing) ; lint_*, syn_*, multi-CPU,
#                               Modbus RTU, identity and the other targets
#                               of main removed
#-----------------------------------------------------------------------------

name        : asylum:soc:PicoSoC:4.8.5
description : SoC with OpenBlaze8/WardRV, switch, led, UART, SPI, I2C, PWM, GIC, Timer, RAM, CRC, Spinlock and Mailbox

#=========================================
generate:
#=========================================
  # Next line is a pragma, don't modify
  #<GENERATE_BEGIN>
  gen_rv32i_user_c :
    generator : rvcc_gen
    parameters :
      file         : esw/demo/user.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose
      logical_name : asylum

  gen_rv32i_user_c_uart_9600 :
    generator : rvcc_gen
    parameters :
      file         : esw/demo/user.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=9600
      logical_name : asylum

  gen_rv32i_user_test_gpio :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_gpio.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600
      logical_name : asylum

  gen_rv32i_user_test_uart :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_uart.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600
      logical_name : asylum

  gen_rv32i_user_test_spi :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_spi.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600 -DHAVE_SPI
      logical_name : asylum

  gen_rv32i_user_test_timer :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_timer.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600
      logical_name : asylum

  gen_rv32i_user_test_crc :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_crc.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600
      logical_name : asylum

  gen_rv32i_user_test_spinlock :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_spinlock.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600
      logical_name : asylum

  gen_rv32i_user_test_gic :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_gic.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600
      logical_name : asylum

  gen_rv32i_user_test_ram :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_ram.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600
      logical_name : asylum

  gen_rv32i_user_test_i2c :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_i2c.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600
      logical_name : asylum

  gen_rv32i_user_test_pwm :
    generator : rvcc_gen
    parameters :
      file         : esw/test/test_pwm.c
      type         : c
      entity       : ROM_user
      cflags       : -Iesw/include --verbose -DHAVE_UART -DCLOCK_FREQ=12500000 -DBAUD_RATE=921600
      logical_name : asylum

  gen_rv32i_supervisor_c :
    generator : rvcc_gen
    parameters :
      file         : esw/system/supervisor.c
      type         : c
      entity       : ROM_supervisor
      cflags       : -Iesw/include --verbose
      logical_name : asylum

  gen_rv32i_supervisor_c_tmr :
    generator : rvcc_gen
    parameters :
      file         : esw/system/supervisor.c
      type         : c
      entity       : ROM_supervisor
      cflags       : -Iesw/include --verbose -DSAFETY_TMR
      logical_name : asylum

  #<GENERATE_END>
  # Previous line is a pragma, don't modify

#=========================================
filesets:
#=========================================
  #---------------------------------------
  pbcc_dep:
  #---------------------------------------
    depend:
      - ">=asylum:utils:generators:1.0.0"      

  #---------------------------------------
  files_hdl:
  #---------------------------------------
    files        :
      - hdl/cpu_wrapper.vhd
      - hdl/cpu_safety.vhd
      - hdl/PicoSoC_pkg.vhd
      - hdl/PicoSoC_clkrst.vhd
      - hdl/PicoSoC_pads.vhd
      - hdl/PicoSoC_hwla.vhd
      - hdl/PicoSoC_tap.vhd
      - hdl/PicoSoC_inject.vhd
      - hdl/PicoSoC_jtag_over_uart.vhd
      - hdl/PicoSoC_top.vhd
      - hdl/PicoSoC_user.vhd
      - hdl/PicoSoC_supervisor.vhd
      # Arguments of hwla2vcd.py (copied to hwla/ of the work root by
      # asylum:debug:HWLA), next to it in the build of a target
      - tools/hwla/hwla_wardrv_fsm.args : {file_type : user, copyto : hwla/hwla_wardrv_fsm.args}
      - tools/hwla/hwla_openblaze8.args : {file_type : user, copyto : hwla/hwla_openblaze8.args}
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:utils:pkg:1.11.0" # vote of sbi_pkg
      - ">=asylum:target:techmap:1.0.0"
      - ">=asylum:component:clock_divider:1.0.0"
      - ">=asylum:component:GPIO:1.0.0"
      - ">=asylum:component:crc:1.0.0"
      - ">=asylum:communication:uart:3.1.0" # uart_core
      - ">=asylum:communication:SPI:1.0.0"
      - ">=asylum:infrastructure:icn:1.0.0"
      - ">=asylum:system:GIC:2.0.0"
      - ">=asylum:system:spinlock:1.0.0"
      - ">=asylum:system:mailbox:1.1.0"
      - ">=asylum:communication:I2C:1.0.0"
      - ">=asylum:component:PWM:1.0.0"
      - ">=asylum:debug:HWLA:3.1.0" # hwla2vcd.py --signal, copied to hwla/
      - ">=asylum:debug:jtag:1.3.0" # jtag_bitbang, jtag_axis (HWLA_LINK jtag)
      - ">=asylum:component:fifo:1.0.0"
      - ">=asylum:component:timer:2.0.0"
      - ">=asylum:component:ram:1.2.0"
      - ">=asylum:processor:OpenBlaze8:1.0.0"
      - ">=asylum:processor:WardRV:1.2.0"
      
  #---------------------------------------
  files_sim:
  #---------------------------------------
    files:
      - sim/picosoc/tb_PicoSoC_bfm_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_pkg.vhd
      - sim/picosoc/tb_PicoSoC_switch_pkg.vhd
      - sim/picosoc/tb_PicoSoC_it_user_pkg.vhd
      - sim/picosoc/tb_PicoSoC_uart_pkg.vhd
      - sim/picosoc/tb_PicoSoC_sequence_pkg.vhd
      - sim/picosoc/tb_PicoSoC_fault_none_pkg.vhd
      - sim/picosoc/tb_PicoSoC_fault_lock_step_pkg.vhd
      - sim/picosoc/tb_PicoSoC_fault_tmr_pkg.vhd
      - sim/picosoc/tb_PicoSoC_fault_diff_pkg.vhd
      - sim/picosoc/tb_PicoSoC_hwla_pkg.vhd
      - sim/picosoc/tb_PicoSoC_hello_pkg.vhd
      - sim/picosoc/tb_PicoSoC_pad_mux_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_chain_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_inject_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_inject_cpu_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_status_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_cpu_pkg.vhd
      - sim/picosoc/tb_PicoSoC_bitbang_pkg.vhd
      - sim/picosoc/tb_PicoSoC_bitbang_chain_pkg.vhd
      - sim/picosoc/tb_PicoSoC_bitbang_inject_pkg.vhd
      - sim/picosoc/tb_PicoSoC_bitbang_cpu_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_last_pkg.vhd
      - sim/picosoc/tb_PicoSoC_jtag_glitch_pkg.vhd
      - sim/picosoc/tb_PicoSoC_trap_pulse_pkg.vhd
      - sim/picosoc/tb_PicoSoC_trap_reset_pkg.vhd
      - sim/picosoc/tb_PicoSoC_trap_tap_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_gpio_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_uart_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_timer_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_gic_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_mailbox_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_i2c_pkg.vhd
      - sim/picosoc/tb_PicoSoC_test_pwm_pkg.vhd
      - sim/picosoc/tb_PicoSoC_tests_pkg.vhd
      - sim/picosoc/tb_PicoSoC.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_bfm_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_basic_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_fault_lock_step_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_fault_tmr_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_sequence_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu_tests_pkg.vhd
      - sim/modbus_rtu/tb_PicoSoC_modbus_rtu.vhd
      - sim/mem/memory.mem         : {file_type : user, copyto : memory.mem   }
      - sim/mem/memoryOTP.mem      : {file_type : user, copyto : memoryOTP.mem}
    file_type : vhdlSource-2008
    depend :
      - ">=asylum:utils:pkg:1.10.0" # string_pkg list_* (TESTS_LIST)
      - fmf:memory:flash_nor
      - bitvis:verification:uvvm
      - ">=asylum:verification:uvvm:1.3.0" # jtag_bfm_pkg (JTAG BFM, chain fields), rbb_bfm_pkg (remote_bitbang BFM)

  #---------------------------------------
  # OpenOCD co-simulations (tb_PicoSoC_openocd) : OpenOCD configurations
  # of the board (tools/openocd) and scenarios (sim/openocd) copied to
  # openocd/ of the work root, next to gdb_lib.py of WardRV (default target
  # of asylum:processor:WardRV)
  #---------------------------------------
  files_sim_openocd:
  #---------------------------------------
    files:
      - sim/openocd/tb_PicoSoC_openocd.vhd
      - tools/openocd/remote_bitbang.cfg : {file_type : user, copyto : openocd/remote_bitbang.cfg}
      - tools/openocd/picosoc.cfg        : {file_type : user, copyto : openocd/picosoc.cfg}
      - tools/openocd/discover.cfg       : {file_type : user, copyto : openocd/discover.cfg}
      - tools/openocd/discover.tcl       : {file_type : user, copyto : openocd/discover.tcl}
      - tools/openocd/jtag_axis.tcl      : {file_type : user, copyto : openocd/jtag_axis.tcl}
      - tools/openocd/picosoc_cmds.tcl   : {file_type : user, copyto : openocd/picosoc_cmds.tcl}
      - sim/openocd/gdb.cfg              : {file_type : user, copyto : openocd/gdb.cfg}
      - sim/openocd/generic.cfg          : {file_type : user, copyto : openocd/generic.cfg}
      - sim/openocd/picosoc.py           : {file_type : user, copyto : openocd/picosoc.py}
      - sim/openocd/chain.cfg            : {file_type : user, copyto : openocd/chain.cfg}
      - sim/openocd/discover_check.cfg   : {file_type : user, copyto : openocd/discover_check.cfg}
      - sim/openocd/generic_check.cfg    : {file_type : user, copyto : openocd/generic_check.cfg}
      - sim/openocd/hwla_check.cfg       : {file_type : user, copyto : openocd/hwla_check.cfg}
      - sim/openocd/hwla_vcd.sh          : {file_type : user, copyto : openocd/hwla_vcd.sh}
    file_type : vhdlSource-2008
    depend :
      - ">=asylum:verification:openocd:1.0.0" # rbb_jtag, rbb_axis, rbb_server.c, cosim.sh
      - ">=asylum:processor:WardRV:1.5.0"     # gdb_lib.py

  #---------------------------------------
  files_ng_medium:
  #---------------------------------------
    files:
      - boards/NanoXplore-DK625V0/pads.py    : {file_type : nx_pads}
      - boards/NanoXplore-DK625V0/options.py : {file_type : nx_options}
      - boards/NanoXplore-DK625V0/features.py: {file_type : nx_features}
    file_type : vhdlSource

  # Next line is a pragma, don't modify
  #<FILESETS_BEGIN>
  #<FILESETS_END>
  # Previous line is a pragma, don't modify

#=========================================
targets:
#=========================================
  # Student branch (ESIEE SEI-5201A labs) : the configurations are numbered
  # in the order of the labs (they differ from main) :
  #  * soc1 : WardRV_fsm, supervisor, SAFETY none, fault injection (the
  #    reference SoC). One CPU, nothing to compare it with : an error
  #    injected by inject_error_i(0) derails the firmware and the supervisor
  #    sees nothing (scenario fault_none) ;
  #  * soc2 : soc1 with the lock-step of cpu_safety (to write) ;
  #  * soc3 : soc1 with the TMR of cpu_safety (to write).
  # The soc2 / soc3 targets fail on the assertion of cpu_safety until the
  # students write it : leading '_', no CI job, not in nonreg, run by hand
  # (make _sim_soc2_wardrv_fsm_fault_c_user).
  #
  # Configurations : the parameters of a configuration (DUT and board) are
  # anchored on its first target (parameters : &cfg_<config>), the other
  # targets of the configuration reuse them (parameters : *cfg_<config>) and
  # add their own (test bench, firmware, scenarios) with parameters_append.
  # parameters_append is added to the inherited one (<<) : the last value of
  # a parameter wins (USER_SAFETY of the soc2 / soc3 targets)

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target (DON'T RUN)
    filesets        :
      - files_hdl
    toplevel        : PicoSoC_top
    default_tool    : ghdl

  #---------------------------------------
  sim: &sim
  #---------------------------------------
    << : *default
    description     : default rule to sim (DON'T RUN)
    default_tool    : ghdl
    toplevel        : tb_PicoSoC
    parameters   :
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000
    filesets_append :
      - files_sim
      - pbcc_dep
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  # soc1 : the scenarios of esw/demo/user.c, one target each
  # (sim_soc1_wardrv_fsm_fault_c_user_<test>)
  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_user: &sim_soc1_wardrv_fsm_fault_c_user
  #---------------------------------------
    << : *sim
    description       : Simulation of the test esw/demo/user.c                - With    Supervisor, Safety None     , With    Fault Injection, build check (one scenario per target sim_soc1_wardrv_fsm_fault_c_user_<test>)
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    parameters        : &cfg_soc1_wardrv_fsm_fault
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000
      # SoC User Configuration
      - USER_BAUD_RATE=921600
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=true
      # Debug
      - DEBUG_ENABLE=false
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user
      - TESTS_LIST

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_user_switch:
  #---------------------------------------
    << : *sim_soc1_wardrv_fsm_fault_c_user
    description       : Simulation of the test esw/demo/user.c                - With    Supervisor, Safety None     , With    Fault Injection, scenario switch
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user
      - TESTS_LIST=switch

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_user_it_user:
  #---------------------------------------
    << : *sim_soc1_wardrv_fsm_fault_c_user
    description       : Simulation of the test esw/demo/user.c                - With    Supervisor, Safety None     , With    Fault Injection, scenario it_user
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user
      - TESTS_LIST=it_user

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_user_fault_none:
  #---------------------------------------
    << : *sim_soc1_wardrv_fsm_fault_c_user
    description       : Simulation of the test esw/demo/user.c                - With    Supervisor, Safety None     , With    Fault Injection, scenario fault_none (an error in the only CPU, the firmware derails, the supervisor sees nothing)
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user
      - TESTS_LIST=fault_none

  #---------------------------------------
  # Integration tests (esw/test/test_<ip>.c) in soc1 : the nonreg of the
  # SoC when the CPU is modified
  #---------------------------------------

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_gpio:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_gpio.c - GPIO registers, LED and switch pins, edges polled
    generate          : [gen_rv32i_user_test_gpio,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=test_gpio
      - TESTS_LIST=test_gpio

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_uart:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_uart.c - UART registers, TX and RX pins, RX interrupt through the GIC
    generate          : [gen_rv32i_user_test_uart,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=test_uart
      - TESTS_LIST=test_uart

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_spi:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_spi.c - SPI registers, SPI flash model (status, read, page program)
    generate          : [gen_rv32i_user_test_spi,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=m25p40
      - FIRMWARE=test_spi
      - TESTS_LIST=test_spi

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_timer:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_timer.c - Timer registers, period and interrupt through the GIC
    generate          : [gen_rv32i_user_test_timer,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=test_timer
      - TESTS_LIST=test_timer

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_crc:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_crc.c - CRC registers, CRC16 Modbus of known vectors
    generate          : [gen_rv32i_user_test_crc,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=test_crc
      - TESTS_LIST=test_crc

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_spinlock:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_spinlock.c - Spinlock registers, test-and-set and release
    generate          : [gen_rv32i_user_test_spinlock,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=test_spinlock
      - TESTS_LIST=test_spinlock

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_gic:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_gic.c - GIC registers, it_user_i masked, pending and taken
    generate          : [gen_rv32i_user_test_gic,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=test_gic
      - TESTS_LIST=test_gic

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_ram:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_ram.c - RAM1 and RAM2 address and data, unmapped address
    generate          : [gen_rv32i_user_test_ram,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=test_ram
      - TESTS_LIST=test_ram

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_i2c:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_i2c.c - I2C registers, master and slave transfers with the I2C BFM, NACK, SCL at 100 kHz
    generate          : [gen_rv32i_user_test_i2c,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=test_i2c
      - TESTS_LIST=test_i2c

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_test_pwm:
  #---------------------------------------
    << : *sim
    description       : Integration test esw/test/test_pwm.c - PWM registers, period and duty cycle of pwm_o for 2 duties, low when disabled
    generate          : [gen_rv32i_user_test_pwm,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=test_pwm
      - TESTS_LIST=test_pwm

  #---------------------------------------
  # OpenOCD co-simulations in soc1 (tb_PicoSoC_openocd, JTAG pins of the
  # UART pads, debug_mux_sel_i 10, PIN mode of asylum:verification:openocd ;
  # needs gcc, openocd and gdb-multiarch : hooks rbb/cosim.sh of the kit,
  # run in the work root ; no waveform). SAFETY none : no INJECT step in
  # picosoc.py (no copy of the CPU to differ from)
  # * openocd_jtag : chain of the user CPU and injection / status TAPs
  #   given by sim/openocd/gdb.cfg, GDB scenario sim/openocd/picosoc.py ;
  #   _openocd_bitbang : the same through JTAG over the UART
  #   (debug_mux_sel_i 11, too long for the CI)
  # * openocd_discover, openocd_generic : the chain of
  #   emu_ng_medium_soc1_wardrv_fsm_fault_debug (user CPU, HWLA jtag_axis,
  #   injection / status TAP) discovered by tools/openocd/discover.cfg
  #   (checked by sim/openocd/discover_check.cfg), and by
  #   tools/openocd/picosoc.cfg without picosoc_chain (GDB scenario
  #   picosoc.py on sim/openocd/generic.cfg)
  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_user_openocd_jtag: &sim_openocd
  #---------------------------------------
    << : *default
    description       : OpenOCD + GDB co-simulation of the test esw/demo/user.c - With    Supervisor, Safety None     , With    Fault Injection, JTAG chain of the user CPU and injection TAPs, JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), scenario sim/openocd/picosoc.py (IDCODEs, GDB halt / resume of the user CPU, no INJECT with SAFETY none)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    filesets_append   : &filesets_openocd
      - files_sim
      - files_sim_openocd
      - pbcc_dep
    parameters        : &cfg_soc1_wardrv_fsm_fault_openocd
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000
      - JTAG_BAUD_RATE=921600

      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=true

      # Debug
      - DEBUG_ENABLE=true
      - USER_CPU_DEBUG_ENABLE=true

      # Test Bench Configuration
      - TB_WATCHDOG=200000
    parameters_append :
      - DEBUG_MUX_SEL=10
    tools : &tools_openocd
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["$(GHDL_RUN_OPTION)","--ieee-asserts=disable"]
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start]
      post_run          : [cosim_check]

  #---------------------------------------
  _sim_soc1_wardrv_fsm_fault_c_user_openocd_bitbang:
  #---------------------------------------
    << : *sim_openocd
    description       : OpenOCD + GDB co-simulation of the test esw/demo/user.c - With    Supervisor, Safety None     , With    Fault Injection, JTAG chain of the user CPU and injection TAPs, JTAG over the UART pads (debug_mux_sel_i 11, 921600 baud), scenario sim/openocd/picosoc.py (IDCODEs, GDB halt / resume of the user CPU, no INJECT with SAFETY none)
    parameters_append :
      - DEBUG_MUX_SEL=11

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_user_openocd_discover:
  #---------------------------------------
    << : *default
    description       : OpenOCD co-simulation of the test esw/demo/user.c - With    Supervisor, Safety None     , With    Fault Injection, JTAG chain of 3 TAPs (user CPU, HWLA jtag_axis, injection, as emu_ng_medium_soc1_wardrv_fsm_fault_debug), JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), discovery of the chain tools/openocd/discover.cfg checked by sim/openocd/discover_check.cfg (number of TAPs, IDCODEs, picosoc_chain)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    filesets_append   : *filesets_openocd
    parameters        : &cfg_soc1_wardrv_fsm_fault_openocd_debug
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000

      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=true

      # Debug
      - DEBUG_ENABLE=true
      - HWLA_LINK=jtag
      - USER_CPU_DEBUG_ENABLE=true

      # Test Bench Configuration
      - TB_WATCHDOG=200000
      - DEBUG_MUX_SEL=10
    tools             : *tools_openocd
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start_discover]
      post_run          : [cosim_check]

  #---------------------------------------
  sim_soc1_wardrv_fsm_fault_c_user_openocd_generic:
  #---------------------------------------
    << : *default
    description       : OpenOCD + GDB co-simulation of the test esw/demo/user.c - With    Supervisor, Safety None     , With    Fault Injection, JTAG chain of 3 TAPs (user CPU, HWLA jtag_axis, injection, as emu_ng_medium_soc1_wardrv_fsm_fault_debug), JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), tools/openocd/picosoc.cfg without picosoc_chain (chain discovered), scenario sim/openocd/picosoc.py (IDCODEs, GDB halt / resume of the user CPU, no INJECT with SAFETY none)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    filesets_append   : *filesets_openocd
    parameters        : *cfg_soc1_wardrv_fsm_fault_openocd_debug
    tools             : *tools_openocd
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start_generic]
      post_run          : [cosim_check]

  #---------------------------------------
  # soc2 (lock-step) and soc3 (TMR) : fail until cpu_safety is written
  #---------------------------------------
  _sim_soc2_wardrv_fsm_fault_c_user:
  #---------------------------------------
    << : *sim
    description       : Simulation of the test esw/demo/user.c                - With    Supervisor, Safety Lock-Step, With    Fault Injection (fails until the lock-step of cpu_safety is written)
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - USER_SAFETY=lock-step
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user
      - TESTS_LIST=switch,it_user,fault_lock_step

  #---------------------------------------
  _sim_soc3_wardrv_fsm_fault_c_user:
  #---------------------------------------
    << : *sim
    description       : Simulation of the test esw/demo/user.c                - With    Supervisor, Safety TMR      , With    Fault Injection, IT and fault inputs active low (board) (fails until the TMR of cpu_safety is written)
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c_tmr]
    parameters        : *cfg_soc1_wardrv_fsm_fault
    parameters_append :
      - USER_SAFETY=tmr
      - USER_IT_POLARITY=low
      - USER_FAULT_POLARITY=low
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user
      - TESTS_LIST=switch,it_user,fault_tmr

  #---------------------------------------
  # HWLA (DEBUG_ENABLE) : it captures the bus of the user CPU around a
  # difference of the redundant CPUs, so its checks need soc2 (lock-step,
  # to write) : without difference (soc1) the HWLA stays armed
  # * _openocd_hwla : soc2, HWLA_LINK jtag, OpenOCD script
  #   sim/openocd/hwla_check.cfg on tools/openocd/picosoc.cfg (chain
  #   discovered, picosoc_hwla_status, picosoc_inject : one error, the
  #   supervisor resets the user SoC once, picosoc_hwla_dump of the capture
  #   to hwla.bin, decoded by hwla/hwla2vcd.py with
  #   hwla/hwla_wardrv_fsm.args : hooks of sim/openocd/hwla_vcd.sh)
  # * _hwla, _hwla_jtag : scenario hwla (capture checked against the user
  #   ROM, on debug_uart_tx_o or read through the TAP of jtag_axis). It
  #   needs led_diff_o = the difference flags and a flag that stays set :
  #   soc2 WITHOUT the supervisor. SoC clock 1.152 MHz (10 cycles per bit
  #   at 115200 baud)
  #---------------------------------------
  _sim_soc2_wardrv_fsm_fault_c_user_openocd_hwla:
  #---------------------------------------
    << : *default
    description       : OpenOCD co-simulation of the test esw/demo/user.c - With    Supervisor, Safety Lock-Step, With    Fault Injection, JTAG chain of 3 TAPs (user CPU, HWLA jtag_axis, injection), HWLA_LINK jtag, JTAG pins on the UART pads (debug_mux_sel_i 10, TCK = FSYS_INT / 8), script sim/openocd/hwla_check.cfg (chain discovered, picosoc_hwla_status, picosoc_inject, picosoc_hwla_dump), capture decoded by hwla2vcd.py (fails until the lock-step of cpu_safety is written)
    default_tool      : ghdl
    toplevel          : tb_PicoSoC_openocd
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    filesets_append   : *filesets_openocd
    parameters        :
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000

      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=lock-step
      - USER_FAULT_INJECTION=true

      # Debug
      - DEBUG_ENABLE=true
      - HWLA_LINK=jtag
      - USER_CPU_DEBUG_ENABLE=true

      # Test Bench Configuration
      - TB_WATCHDOG=200000
      - DEBUG_MUX_SEL=10
    tools             : *tools_openocd
    hooks :
      pre_build         : [cosim_build]
      pre_run           : [cosim_start_hwla]
      post_run          : [cosim_check, hwla_vcd]

  #---------------------------------------
  _sim_soc2_wardrv_fsm_fault_c_user_hwla: &sim_soc2_wardrv_fsm_fault_c_user_hwla
  #---------------------------------------
    << : *sim
    description       : Simulation of the test esw/demo/user.c                - Without Supervisor, Safety Lock-Step, With    Fault Injection, HWLA capture of the error on debug_uart_tx_o, SoC clock 1.152 MHz (10 cycles per bit at 115200 baud) (fails until the lock-step of cpu_safety is written)
    generate          : [gen_rv32i_user_c,gen_rv32i_supervisor_c]
    parameters        :
      - CPU_MODEL=WardRV_fsm
      - FSYS=2304000
      - FSYS_INT=1152000

      # Platform Configuration
      - SUPERVISOR=false
      - USER_SAFETY=lock-step
      - USER_FAULT_INJECTION=true

      # Debug
      - DEBUG_ENABLE=true
      - HWLA_DEPTH=128
      - HWLA_PRE_TRIGGER=48
      - HWLA_TIMESTAMP_WIDTH=24

      # Test Bench Configuration
      - TB_WATCHDOG=200000
      - SPI_MODEL=none
      - FIRMWARE=user
      - TESTS_LIST=hwla

  #---------------------------------------
  _sim_soc2_wardrv_fsm_fault_c_user_hwla_jtag:
  #---------------------------------------
    << : *sim_soc2_wardrv_fsm_fault_c_user_hwla
    description       : Simulation of the test esw/demo/user.c                - Without Supervisor, Safety Lock-Step, With    Fault Injection, HWLA capture of the error read through the TAP of jtag_axis (HWLA_LINK jtag, TCK of 10 SoC clock cycles), same configuration and stimulus as _sim_soc2_wardrv_fsm_fault_c_user_hwla (fails until the lock-step of cpu_safety is written)
    parameters_append :
      - HWLA_LINK=jtag

  #---------------------------------------
  # NG-MEDIUM board, soc1 : the reference build of the labs (DEBUG_ENABLE
  # false, no CPU debugger : its LUT, FF and Fmax are the reference
  # figures) ; _debug : the HWLA (HWLA_LINK jtag), the injection / status
  # TAP and the debugger of the user CPU (OpenOCD on the board :
  # tools/openocd). soc2 / soc3 : fail until cpu_safety is written
  #---------------------------------------
  emu_ng_medium_soc1_wardrv_fsm_fault: &emu_ng_medium_soc1_wardrv_fsm_fault
  #---------------------------------------
    description       : NanoXplore NG_MEDIUM Board of the test esw/demo/user.c                - With    Supervisor, Safety None     , With    Fault Injection (reference build, no debug)
    default_tool      : nxmap
    filesets          :
      - files_hdl
      - files_ng_medium
      - pbcc_dep
    generate          : [gen_rv32i_user_c_uart_9600,gen_rv32i_supervisor_c]
    parameters        : &cfg_ng_medium_wardrv_fsm
      - CPU_MODEL=WardRV_fsm
      - FSYS=25000000
      - FSYS_INT=12500000
      - USER_NB_SWITCH=4
      - USER_NB_LED0=8
      - USER_NB_LED1=8
      - RESET_POLARITY=low
      - USER_IT_POLARITY=low
      - USER_FAULT_POLARITY=low
      # SoC User Configuration
      - USER_BAUD_RATE=9600
      - HWLA_BAUD_RATE=9600
      - HWLA_DEPTH=1024
      - HWLA_PRE_TRIGGER=16
      - JTAG_BAUD_RATE=9600
      - USER_UART_DEPTH_TX=4
      - USER_UART_DEPTH_RX=4
      - USER_SPI_DEPTH_CMD=4
      - USER_SPI_DEPTH_TX=4
      - USER_SPI_DEPTH_RX=4
      - USER_SPI_NB_IO=2
    parameters_append :
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=true
      # Debug
      - DEBUG_ENABLE=false
    flags             :
      TARGET  : NANOXPLORE_NG_MEDIUM
    tools             :
      nxmap:
        fpga         : NG-MEDIUM
        program      : True
        logical_name : asylum
    toplevel          : PicoSoC_top

  #---------------------------------------
  emu_ng_medium_soc1_wardrv_fsm_fault_debug:
  #---------------------------------------
    << : *emu_ng_medium_soc1_wardrv_fsm_fault
    description       : NanoXplore NG_MEDIUM Board of the test esw/demo/user.c                - With    Supervisor, Safety None     , With    Fault Injection, HWLA (captures read through JTAG with HWLA_LINK jtag and picosoc_hwla_dump of tools/openocd/picosoc.cfg, no trigger without difference), JTAG chain of 3 TAPs (injection / status, HWLA jtag_axis, user CPU), OpenOCD on the UART pads (debug_mux_sel_i 10 or 11)
    generate          : [gen_rv32i_user_c_uart_9600,gen_rv32i_supervisor_c]
    parameters_append :
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=none
      - USER_FAULT_INJECTION=true
      # Debug
      - DEBUG_ENABLE=true
      - HWLA_LINK=jtag
      - USER_CPU_DEBUG_ENABLE=true

  #---------------------------------------
  _emu_ng_medium_soc2_wardrv_fsm_fault:
  #---------------------------------------
    << : *emu_ng_medium_soc1_wardrv_fsm_fault
    description       : NanoXplore NG_MEDIUM Board of the test esw/demo/user.c                - With    Supervisor, Safety Lock-Step, With    Fault Injection (fails until the lock-step of cpu_safety is written)
    generate          : [gen_rv32i_user_c_uart_9600,gen_rv32i_supervisor_c]
    parameters_append :
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=lock-step
      - USER_FAULT_INJECTION=true
      # Debug
      - DEBUG_ENABLE=false

  #---------------------------------------
  _emu_ng_medium_soc2_wardrv_fsm_fault_debug:
  #---------------------------------------
    << : *emu_ng_medium_soc1_wardrv_fsm_fault
    description       : NanoXplore NG_MEDIUM Board of the test esw/demo/user.c                - With    Supervisor, Safety Lock-Step, With    Fault Injection, HWLA (trigger on the lock-step difference, HWLA_LINK jtag), JTAG chain of 3 TAPs (injection / status, HWLA jtag_axis, user CPU) (fails until the lock-step of cpu_safety is written)
    generate          : [gen_rv32i_user_c_uart_9600,gen_rv32i_supervisor_c]
    parameters_append :
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=lock-step
      - USER_FAULT_INJECTION=true
      # Debug
      - DEBUG_ENABLE=true
      - HWLA_LINK=jtag
      - USER_CPU_DEBUG_ENABLE=true

  #---------------------------------------
  _emu_ng_medium_soc3_wardrv_fsm_fault:
  #---------------------------------------
    << : *emu_ng_medium_soc1_wardrv_fsm_fault
    description       : NanoXplore NG_MEDIUM Board of the test esw/demo/user.c                - With    Supervisor, Safety TMR      , With    Fault Injection (fails until the TMR of cpu_safety is written)
    generate          : [gen_rv32i_user_c_uart_9600,gen_rv32i_supervisor_c_tmr]
    parameters_append :
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      # Debug
      - DEBUG_ENABLE=false

  #---------------------------------------
  _emu_ng_medium_soc3_wardrv_fsm_fault_debug:
  #---------------------------------------
    << : *emu_ng_medium_soc1_wardrv_fsm_fault
    description       : NanoXplore NG_MEDIUM Board of the test esw/demo/user.c                - With    Supervisor, Safety TMR      , With    Fault Injection, HWLA (trigger on a TMR difference, HWLA_LINK jtag), JTAG chain of 3 TAPs (injection / status, HWLA jtag_axis, user CPU) (fails until the TMR of cpu_safety is written)
    generate          : [gen_rv32i_user_c_uart_9600,gen_rv32i_supervisor_c_tmr]
    parameters_append :
      # Platform Configuration
      - SUPERVISOR=true
      - USER_SAFETY=tmr
      - USER_FAULT_INJECTION=true
      # Debug
      - DEBUG_ENABLE=true
      - HWLA_LINK=jtag
      - USER_CPU_DEBUG_ENABLE=true

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # Hooks of sim_*_openocd_* (cwd = work_root, rbb/cosim.sh of the kit
  # asylum:verification:openocd) : librbb.so, OpenOCD + GDB, result
  #---------------------------------------
  cosim_build :
    cmd : [bash, rbb/cosim.sh, build]

  cosim_start :
    cmd : [bash, rbb/cosim.sh, start, openocd/gdb.cfg, openocd/picosoc.py]

  cosim_start_discover :
    cmd : [bash, rbb/cosim.sh, start, openocd/discover_check.cfg]

  cosim_start_generic :
    cmd : [bash, rbb/cosim.sh, start, openocd/generic.cfg, openocd/picosoc.py]

  cosim_start_hwla :
    cmd : [bash, rbb/cosim.sh, start, openocd/hwla_check.cfg]

  cosim_check :
    cmd : [bash, rbb/cosim.sh, check]

  #---------------------------------------
  # Hook of sim_*_openocd_hwla (cwd = work_root) : the capture decoded
  #---------------------------------------
  hwla_vcd :
    cmd : [bash, openocd/hwla_vcd.sh, vcd, hwla/hwla_wardrv_fsm.args, "-d", "64", "-p", "32"]

#=========================================
parameters :
#=========================================

  FSYS :
    description : External frequency
    datatype    : int
    default     : 500000000
    paramtype   : generic

  FSYS_INT :
    description : Internal frequency
    datatype    : int
    default     : 500000000
    paramtype   : generic

  USER_NB_CPU :
    description : Number of User CPU
    datatype    : int
    default     : 1
    paramtype   : generic
    
  USER_BAUD_RATE :
    description : Baud Rate
    datatype    : int
    default     : 9600
    paramtype   : generic

  HWLA_BAUD_RATE :
    description : Baud rate of the UART of the HWLA captures (DEBUG_ENABLE)
    datatype    : int
    default     : 115200
    paramtype   : generic

  HWLA_DEPTH :
    description : Samples of a capture of the HWLA, power of 2 (DEBUG_ENABLE)
    datatype    : int
    default     : 64
    paramtype   : generic

  HWLA_PRE_TRIGGER :
    description : Samples of the HWLA before the trigger sample, 0 to HWLA_DEPTH-1 (DEBUG_ENABLE)
    datatype    : int
    default     : 32
    paramtype   : generic

  HWLA_TIMESTAMP_WIDTH :
    description : Width of the timestamp of a sample of the HWLA (DEBUG_ENABLE)
    datatype    : int
    default     : 16
    paramtype   : generic

  HWLA_LINK :
    description : Link of the HWLA captures (DEBUG_ENABLE), uart (debug_uart_tx_o, UART pads in mode 01) or jtag (TAP of jtag_axis in the JTAG chain)
    datatype    : str
    default     : uart
    paramtype   : generic

  JTAG_BAUD_RATE :
    description : Baud rate of JTAG over the UART pads (debug_mux_sel_i 11)
    datatype    : int
    default     : 115200
    paramtype   : generic

  USER_UART_DEPTH_TX :
    description : UART TX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_UART_DEPTH_RX :
    description : UART RX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_SPI_DEPTH_CMD :
    description : SPI TX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_SPI_DEPTH_TX :
    description : SPI TX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_SPI_DEPTH_RX :
    description : SPI RX Depth FIFO
    datatype    : int
    default     : 0
    paramtype   : generic

  USER_SPI_NB_IO :
    description : SPI IO lines with a pad (MOSI, MISO, WP#, HOLD#, ...), up to 8
    datatype    : int
    default     : 8
    paramtype   : generic

  USER_NB_SWITCH :
    description : Switch number on board
    datatype    : int
    default     : 8
    paramtype   : generic

  USER_NB_LED0 :
    description : led number on board
    datatype    : int
    default     : 8
    paramtype   : generic

  USER_NB_LED1 :
    description : led number on board
    datatype    : int
    default     : 8
    paramtype   : generic

  RESET_POLARITY :
    description : Polarity of arst_i signal (low / high)
    datatype    : str
    default     : low
    paramtype   : generic

  SUPERVISOR :
    description : Instanciate the supervisor
    datatype    : bool
    default     : true
    paramtype   : generic

  USER_SAFETY :
    description : Safety Algorithm (none / lock-step / tmr)
    datatype    : str
    default     : none
    paramtype   : generic

  USER_FAULT_INJECTION :
    description : Fault injection (inject_error_i flips an instruction bit of a CPU)
    datatype    : bool
    default     : true
    paramtype   : generic

  USER_IT_POLARITY :
    description : Polarity of it_user_i signal (low / high)
    datatype    : str
    default     : low
    paramtype   : generic

  USER_FAULT_POLARITY :
    description : Polarity of inject_err_r_i signal (low / high)
    datatype    : str
    default     : low
    paramtype   : generic

  DEBUG_ENABLE :
    description : Enable the Debug Buss
    datatype    : bool
    default     : false
    paramtype   : generic

  USER_CPU_DEBUG_ENABLE :
    description : Debug unit (WardRV_debug, in cpu_wrapper) of the user CPU of every cluster, in the JTAG chain (WardRV_fsm)
    datatype    : bool
    default     : false
    paramtype   : generic

  SUPERVISOR_CPU_DEBUG_ENABLE :
    description : Debug unit (WardRV_debug, in cpu_wrapper) of the supervisor CPU, in the JTAG chain (WardRV_fsm)
    datatype    : bool
    default     : false
    paramtype   : generic

  CPU_MODEL :
    description : CPU Model (OpenBlaze8 / WardRV_fsm)
    datatype    : str
    default     : WardRV_fsm
    paramtype   : generic

  SPI_MODEL :
    description : SPI Model (m25p40 / s25fl512s)
    datatype    : str
    default     : m25p40
    paramtype   : generic

  TESTS_LIST :
    description : Testbench scenarios, separated by ',' of tb_PicoSoC (switch, it_user, fault_none, fault_lock_step, fault_tmr, hwla, test_<ip>)
    datatype    : str
    paramtype   : generic

  FIRMWARE :
    description : Program of the user ROM for tb_PicoSoC (user / test_<ip>)
    datatype    : str
    default     : user
    paramtype   : generic

  DEBUG_MUX_SEL :
    description : Function of the UART pads in tb_PicoSoC_openocd, 10 (JTAG pins) or 11 (JTAG over the UART)
    datatype    : str
    default     : 10
    paramtype   : generic

  TB_WATCHDOG :
    description : Testbench timeout of one wait (clk_i cycles)
    datatype    : int
    default     : 10000
    paramtype   : generic

